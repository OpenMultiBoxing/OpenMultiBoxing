<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package (CI fills in the Version). OpenMultiBoxing.store next to the exe tells OMB it's the Store
     install: settings in Documents\OpenMultiBoxing, updates by the Store. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="MooreaTV.OpenMultiBoxing" Publisher="CN=97B4862C-6FAA-4468-9721-2D8AF44F2A10"
            Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>OpenMultiBoxing</DisplayName>
    <PublisherDisplayName>MooreaTV</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="OpenMultiBoxing" Executable="OpenMultiBoxing.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="OpenMultiBoxing" Description="Opensource MultiBoxing"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
